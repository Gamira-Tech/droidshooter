+// decryptNonce reverses auth-demo's EncryptData + extra base64 wrapper.
+// nonce = base64( EncryptData(UUID) ) = base64( base64( RSA-OAEP-SHA256(UUID) ) )
+func decryptNonce(nonce string, privateKey *rsa.PrivateKey) (string, error) {
+	outer, err := base64.StdEncoding.DecodeString(nonce)
+	if err != nil {
+		return "", fmt.Errorf("outer base64 decode: %w", err)
+	}
+	cipherText, err := base64.StdEncoding.DecodeString(string(outer))
+	if err != nil {
+		return "", fmt.Errorf("inner base64 decode: %w", err)
+	}
+	decrypted, err := rsa.DecryptOAEP(sha256.New(), rand.Reader, privateKey, cipherText, nil)
+	if err != nil {
+		return "", fmt.Errorf("RSA decrypt: %w", err)
+	}
+	return string(decrypted), nil
+}
+
+// exchangeToken calls auth-demo's token/issue endpoint using the decrypted UUID
+// as the nonce. Returns the JWT string.
+func exchangeToken(authAPI, tokenUUID string) (string, error) {
+	req, err := http.NewRequest(http.MethodGet, authAPI+"/api/v1/token/issue", nil)
+	if err != nil {
+		return "", err
+	}
+	req.Header.Set("x-nonce", tokenUUID)
+
+	resp, err := httpClient.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+
+	data, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return "", err
+	}
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("token exchange failed (status %d): %s", resp.StatusCode, data)
+	}
+
+	var token string
+	if err := json.Unmarshal(data, &token); err != nil {
+		return "", fmt.Errorf("parse token: %v, body: %s", err, data)
+	}
+	return token, nil
 }
 
