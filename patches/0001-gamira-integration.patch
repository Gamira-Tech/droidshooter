+void UDroidshooterIntroUserWidget::ProcessGameserverResponse(const FString& ResponseContent)
+{
+    TSharedPtr<FJsonObject> Root;
+    FString ID, Status;
+    if (!ReadObject(ResponseContent, Root) || !Root->TryGetStringField(TEXT("ticket_id"), ID) || ID.IsEmpty())
+    {
+        CancelTicket();
+        return;
+    }
+    for (TCHAR C : ID)
+    {
+        if (!FChar::IsAlnum(C) && C != TEXT('-') && C != TEXT('_')) { CancelTicket(); return; }
+    }
+    TicketId = ID;
+    Root->TryGetStringField(TEXT("region_id"), TicketRegion);
+    Root->TryGetStringField(TEXT("status"), Status);
+    if (Status == TEXT("cancelled")) { CancelTicket(); return; }
+    const TSharedPtr<FJsonObject>* Connection = nullptr;
+    FString IP;
+    double Port = 0;
+    if (Status == TEXT("matched") && Root->TryGetObjectField(TEXT("connection"), Connection)
+        && (*Connection)->TryGetStringField(TEXT("ip"), IP) && !IP.IsEmpty()
+        && (*Connection)->TryGetNumberField(TEXT("port"), Port) && Port >= 1 && Port <= 65535)
+    {
+        TicketId.Empty(); // A matched ticket is not cancelled when the widget is destroyed.
+        bMatchmaking = false;
+        ServerIPValue = IP;
+        ServerPortValue = FString::FromInt(static_cast<int32>(Port));
+        if (ServerIPBox) ServerIPBox->SetText(FText::FromString(ServerIPValue));
+        if (ServerPortBox) ServerPortBox->SetText(FText::FromString(ServerPortValue));
+        if (UFunction* Function = FindFunction(TEXT("ConnectToOnlineGame"))) ProcessEvent(Function, nullptr);
+        return;
     }
+    if (GetWorld()) GetWorld()->GetTimerManager().SetTimer(MemberTimerHandle, this, &UDroidshooterIntroUserWidget::PollTicket, 0.5f, false);
 }
