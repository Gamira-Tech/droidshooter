+// printCrashLog finds the most recently modified UE5 log in the game's
+// Saved/Logs dir and prints its last 80 lines — the log rotates per instance
+// so we grab the newest one written around crash time.
+func printCrashLog(binary string, idx int) {
+	logDir := filepath.Join(filepath.Dir(binary), "Droidshooter", "Saved", "Logs")
+	entries, err := os.ReadDir(logDir)
+	if err != nil {
+		log.Printf("[%d] crash log dir not found: %s", idx, logDir)
+		return
+	}
+	// sort by mod time descending, pick newest
+	sort.Slice(entries, func(i, j int) bool {
+		fi, _ := entries[i].Info()
+		fj, _ := entries[j].Info()
+		return fi.ModTime().After(fj.ModTime())
+	})
+	for _, e := range entries {
+		if e.IsDir() || !strings.HasSuffix(e.Name(), ".log") {
+			continue
+		}
+		path := filepath.Join(logDir, e.Name())
+		data, err := os.ReadFile(path)
+		if err != nil {
+			continue
+		}
+		lines := strings.Split(string(data), "\n")
+		start := len(lines) - 80
+		if start < 0 {
+			start = 0
+		}
+		log.Printf("[%d] crash log (%s):\n%s", idx, e.Name(), strings.Join(lines[start:], "\n"))
+		return
+	}
+	log.Printf("[%d] no crash log found in %s", idx, logDir)
+}
